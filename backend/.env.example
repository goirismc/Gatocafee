# Ejemplo de variables de entorno para desarrollo
# Copia este archivo a `.env` y ajusta los valores locales. NO subir credenciales.

# Servidor
PORT=5001
NODE_ENV=development

# MongoDB (ejemplo de Atlas). Incluye el nombre de la BD al final (ej: /Gatocafee)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/Gatocafee?retryWrites=true&w=majority
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Opciones de desarrollo
# Si necesitas bypasses de dev, configúralos solo en tu `.env.local` privado.
DEV_ALLOW_UNAUTH=false
DEV_ADMIN_ID=

# Business metadata (opcional)
BUSINESS_NAME=Gatocafee
BUSINESS_ADDRESS=Ciudad, País
BUSINESS_PHONE=
BUSINESS_RUC=

# IVA (ejemplo)
IVA_RATE=0.10# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/gatocafee?retryWrites=true&w=majority

# JWT secret
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Cloudinary (either CLOUDINARY_URL or the separate vars)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: PORT
PORT=5000
